{
  // 訳文の Markdown 構造は原文と 1:1 で対応させることが最優先なので、
  // 原文の書き方に由来する指摘は無効にする。ここを緩めないと
  // 「lint を通すために構造を変える」ことになり、差分同期が壊れる。
  "MD013": false, // 行長。原文の段落の分かれ方をそのまま保つため
  "MD024": false, // 同名の見出し。原文に重複があればそのまま訳す
  "MD025": false, // frontmatter の title と h1 の重複。frontmatter は訳側で付与している
  "MD033": false, // インライン HTML。<Badge>、<video> など原文が使っている
  "MD034": false, // 裸の URL。原文が markdownlint-disable している
  "MD040": false, // 言語指定のないコードフェンス。原文のまま保つ
  "MD060": false, // テーブルの桁揃え。和文は全角なので原文と同じ桁数に揃えられない
  "MD041": false, // 先頭行が h1 でない。frontmatter があるため
}
